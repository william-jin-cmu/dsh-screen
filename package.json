{
  "name": "dsh-screen",
  "version": "0.1.0",
  "description": "Lets a DeepSeek Harness agent see what is on your screen right now, and (opt-in) remember what you looked at so it can answer \"what was I doing\". macOS, on-device.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-screen-helper": "bin/dsh-screen-helper"
  },
  "files": [
    "dist",
    "bin",
    "cordis.patch.yml"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "screen",
    "accessibility",
    "context",
    "macos"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "node scripts/build.mjs && pnpm pack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.7.0"
}
